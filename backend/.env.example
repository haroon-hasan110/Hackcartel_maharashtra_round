# Copy this file to .env and fill in your values.
# NEVER commit a real secret or OAuth token file to source control.

YOUTUBE_API_KEY="your_youtube_data_api_key_here"
YOUTUBE_CLIENT_ID="your_google_oauth_client_id_here"
YOUTUBE_CLIENT_SECRET="your_google_oauth_client_secret_here"
YOUTUBE_REDIRECT_URI="http://localhost:8080/oauth/callback"
YOUTUBE_CHANNEL_ID="your_channel_id_here"
