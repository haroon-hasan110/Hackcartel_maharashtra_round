# Server-side Supabase credentials. Never expose the service role key in the frontend.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# APP_URL: Local URL where the app is hosted. Cloud Run injects its service URL at runtime.
APP_URL="http://localhost:3000"

# Supabase frontend config
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# Local Ollama configuration. Local Ollama does not require an API key.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:8b"
VITE_OLLAMA_MODEL="qwen3:8b"

# Morphic Partner API. Keep the real key only in ignored .env.local.
MORPHIC_API_KEY=""
MORPHIC_BASE_URL="https://api.morphic.com/v1/partner"
MORPHIC_ORG_ID=""
# Canvas project id from the Morphic Studio editor URL: …/editor/<this-id>/canvas
MORPHIC_PROJECT_ID=""
MORPHIC_WORKFLOW_ID=""

# YouTube API configuration for the Python backend feature.
YOUTUBE_API_KEY="your_youtube_data_api_key_here"
YOUTUBE_CLIENT_ID="your_google_oauth_client_id_here"
YOUTUBE_CLIENT_SECRET="your_google_oauth_client_secret_here"
YOUTUBE_REDIRECT_URI="http://localhost:8000/oauth/callback"
YOUTUBE_CHANNEL_ID="your_channel_id_here"

